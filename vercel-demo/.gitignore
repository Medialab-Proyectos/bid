# Carpeta local de la CLI de Vercel (contiene los IDs del proyecto)
.vercel

# Dependencias (este despliegue no tiene ninguna, pero por si acaso)
node_modules

# Variables locales: las credenciales van en el panel de Vercel, NUNCA en git
.env
.env.*

# Sistema
.DS_Store
Thumbs.db

# El build ya no se sube a git: Vercel lo genera el mismo en cada deploy
# corriendo "npm run build:vercel" (ver vercel.json en la raíz del repo).
public
